{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "docs/api",
  "docsRoot": "docs",
  "readme": "none",
  "entryFileName": "index",
  "name": "undevice",
  "excludeInternal": true,
  "hidePageHeader": true,
  "sidebar": {
    "autoConfiguration": true,
    "pretty": true
  },
  "intentionallyNotExported": ["DeviceKindFlags", "PlatformFlags", "ExtensionFlags", "Extensions"]
}
