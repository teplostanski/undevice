{
  "name": "undevice",
  "version": "0.1.3",
  "description": "Runtime-agnostic user-agent device detector",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Igor Teplostanski",
    "email": "contact@teplostanski.me",
    "url": "https://teplostanski.me"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teplostanski/undevice.git"
  },
  "bugs": {
    "url": "https://github.com/teplostanski/undevice/issues"
  },
  "homepage": "https://github.com/teplostanski/undevice#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "publint": "publint",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "user-agent",
    "device",
    "device-detection",
    "runtime-agnostic"
  ],
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-unjs": "^0.6.2",
    "husky": "^9.1.7",
    "publint": "^0.3.22",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "isbot": "^5.2.1"
  }
}
