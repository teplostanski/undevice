{
  "name": "undevice",
  "version": "1.1.0",
  "description": "Runtime-agnostic user-agent device detector",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Teplostanski Igor",
    "email": "hi@teplostanski.me",
    "url": "https://teplostanski.me"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teplostanski/undevice.git"
  },
  "bugs": {
    "url": "https://github.com/teplostanski/undevice/issues"
  },
  "homepage": "https://undevice.hacks.run",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/index.d.mts",
  "exports": {
    "./express": {
      "types": "./dist/express/index.d.mts",
      "import": "./dist/express/index.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepack": "pnpm build",
    "publint": "publint",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:typecheck": "node node_modules/typescript-docs/bin/tsc -p docs/tsconfig.json",
    "docs:build": "pnpm docs:api && pnpm docs:typecheck && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "user-agent",
    "device",
    "device-detection",
    "browser-detection",
    "os-detection",
    "mobile-detection",
    "express",
    "middleware",
    "cloudflare",
    "cloudfront",
    "cdn",
    "typescript",
    "ssr",
    "runtime-agnostic"
  ],
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@shikijs/vitepress-twoslash": "^2.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "crawler-user-agents": "^1.62.0",
    "express": "^5.3.0",
    "husky": "^9.1.7",
    "isbot": "^5.2.2",
    "publint": "^0.3.22",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-docs": "npm:typescript@6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.8.1",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.44"
  }
}
