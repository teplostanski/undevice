{
  "name": "undevice",
  "version": "0.0.0",
  "description": "Runtime-agnostic user-agent device detector",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": {
    "name": "Igor Teplostanski",
    "email": "contact@teplostanski.me",
    "url": "https://teplostanski.me"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teplostanski/undevice.git"
  },
  "bugs": {
    "url": "https://github.com/teplostanski/undevice/issues"
  },
  "homepage": "https://github.com/teplostanski/undevice#readme",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "user-agent",
    "device",
    "device-detection",
    "runtime-agnostic"
  ],
  "devDependencies": {
    "eslint": "^10.7.0",
    "eslint-config-unjs": "^0.6.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "isbot": "^5.2.1"
  }
}
