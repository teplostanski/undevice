{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "extends": ["@teplostanski/biome-config/configs/base"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!dist", "!!coverage", "!!.vscode"]
  },
  "overrides": [
    {
      "includes": ["docs/**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
